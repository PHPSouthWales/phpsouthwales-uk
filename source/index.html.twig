---
layout: base
title: PHP South Wales
use: [events]
---

<h2>Events</h2>

<ul>
  {% for event in data.events %}
    <li>
      <a href="{{ event.url|trim('/', 'right') }}">{{ event.title }}</a>
      -
      <time datetime="{{ event.date|date('Y-m-d') }}">{{ event.date|date('j F Y') }}</time>
    </li>
  {% endfor %}
</ul>
