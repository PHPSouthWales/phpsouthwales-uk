---
layout: base
title: PHP South Wales
use: [events, talks, speakers]
---

<h2>Speakers</h2>

<ul>
  {% for speaker in data.speakers %}
    <li><a href="{{ speaker.url|trim('/', 'right') }}">{{ speaker.name }}</a></li>
  {% endfor %}
</ul>

<h2>Events</h2>

<ul>
  {% for event in data.events %}
    <li><a href="{{ event.url|trim('/', 'right') }}">{{ event.title }}</a></li>
  {% endfor %}
</ul>

<h2>Talks</h2>

<ul>
  {% for talk in data.talks %}
    <li><a href="{{ talk.url|trim('/', 'right') }}">{{ talk.title }}</a></li>
  {% endfor %}
</ul>
